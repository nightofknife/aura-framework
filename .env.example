# Workspace root
AURA_BASE_PATH=E:\aura\aura-framework

# API bind
AURA_API_HOST=127.0.0.1
AURA_API_PORT=18098

# Runtime paths
AURA_LOGGING_LOG_DIR=logs
AURA_STATE_STORE__PATH=./project_state.json

# Remote API mode (disabled by default)
AURA_API_REMOTE_ENABLED=0
AURA_API_AUTH_KEY=change-me
AURA_API_TRUSTED_HOSTS=127.0.0.1,localhost

# Optional feature flags
AURA_API_ENABLE_LOGS=0
AURA_API_ENABLE_PLAN_EDITING=0
AURA_API_ENABLE_HOT_RELOAD_ADMIN=0

# Optional CORS
AURA_API_CORS_ENABLED=0
AURA_API_CORS_ALLOWED_ORIGINS=
